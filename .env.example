# MongoDB connection string (Atlas or any replica set — transactions are required)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&compressors=zlib
MONGODB_DB=pocketledger

# At least 32 random characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
